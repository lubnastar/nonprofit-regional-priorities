        "association", [Associations], "foundation", [Foundations], "total", [Organizations (All Types)],
        "beneficiaries_2022", [Beneficiaries 2022], "income_median_saudi", [Median Income (Saudi)], "food_share", [Food Share %],
        "ss_rate_2022", [SS Rate 2022 %], "ss_rate_avg", [SS Rate Avg 2020-22 %],
        "density_all", [Org Density per 100k], "density_assoc", [Association Density per 100k],
        "fragility", [Fragility Index], "gap", [Gap Score], "gap_rank", [Gap Rank],
        "frag_part", [Fragility Part], "dens_part", [Few Non-profits Part], "source", [Gap Source],
        "quadrant", [Quadrant], "scenarios_top5", [Scenarios in Top 5]
