/// One row per registered non-profit organization (2,723), by region of head office.
table fact_organizations
	lineageTag: 98fb585d-31c2-58c5-be9f-31479af809e7

	/// Surrogate key (reg_no is not unique in the source)
	column org_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 271c6616-9228-5b84-9b40-0d30a8b77163
		summarizeBy: none
		sourceColumn: org_id

		annotation SummarizationSetBy = Automatic

	/// Region key
	column region_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 037af498-640f-580a-91bd-1b3198586b43
		summarizeBy: none
		sourceColumn: region_id

		annotation SummarizationSetBy = Automatic

	/// Organization type key
	column org_type_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f52e99e3-60de-5db9-a251-9f2f908ec798
		summarizeBy: none
		sourceColumn: org_type_id

		annotation SummarizationSetBy = Automatic

	/// Registration number from NCNP
	column reg_no
		dataType: int64
		formatString: 0
		lineageTag: 6ad9137e-2b53-5f7d-9f0d-a083314260cc
		summarizeBy: none
		sourceColumn: reg_no

		annotation SummarizationSetBy = Automatic

	/// Organization name (Arabic, as published)
	column name
		dataType: string
		lineageTag: 60c6602b-5918-5b1c-9b5f-28c5ba9575bc
		summarizeBy: none
		sourceColumn: name

		annotation SummarizationSetBy = Automatic

	/// TRUE when the published name ends with an ellipsis
	column name_truncated
		dataType: boolean
		lineageTag: b1abc134-dcf3-5d80-addf-a98141b9d771
		summarizeBy: none
		sourceColumn: name_truncated

		annotation SummarizationSetBy = Automatic

	partition fact_organizations = m
		mode: import
		source =
				let
				    // 1) read the clean CSV from 02_data; 2) if the folder is not reachable (project moved), use the embedded snapshot
				    Embedded = "",
				    FileBinary = try Binary.Buffer(File.Contents(DataFolder & "\fact_organizations.csv")) otherwise Binary.Decompress(Binary.FromText(Embedded, BinaryEncoding.Base64), Compression.Deflate),
				    Source = Csv.Document(FileBinary, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"org_id", Int64.Type}, {"region_id", Int64.Type}, {"org_type_id", Int64.Type}, {"reg_no", Int64.Type}, {"name", type text}, {"name_truncated", type logical}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

