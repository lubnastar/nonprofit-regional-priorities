/// Social security beneficiaries by region and year, 2005-2022 (Grand Total row removed after reconciliation).
table fact_social_security
	lineageTag: 590c1fc5-00a1-584f-93cb-aeddb335b8de

	/// Region key
	column region_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cbb6213d-cab6-55ce-8d32-2e2a2b2a91b9
		summarizeBy: none
		sourceColumn: region_id

		annotation SummarizationSetBy = Automatic

	/// Year key
	column year
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cec6fff3-8e52-50d2-965c-b3a92801ac13
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	/// Beneficiaries (individuals: head of household and dependants)
	column beneficiaries
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: cc999473-77fc-518b-9501-8d4f24490e94
		summarizeBy: none
		sourceColumn: beneficiaries

		annotation SummarizationSetBy = Automatic

	partition fact_social_security = m
		mode: import
		source =
				let
				    // 1) read the clean CSV from 02_data; 2) if the folder is not reachable (project moved), use the embedded snapshot
				    Embedded = "",
				    FileBinary = try Binary.Buffer(File.Contents(DataFolder & "\fact_social_security.csv")) otherwise Binary.Decompress(Binary.FromText(Embedded, BinaryEncoding.Base64), Compression.Deflate),
				    Source = Csv.Document(FileBinary, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"region_id", Int64.Type}, {"year", Int64.Type}, {"beneficiaries", Int64.Type}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

