/// Population by region and year, 2010-2022.
table fact_population
	lineageTag: 35576af8-981e-5ed1-92c5-52dc019ce45d

	/// Region key
	column region_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 573f2e8d-1101-5b4b-8cc4-36138c0c0ce9
		summarizeBy: none
		sourceColumn: region_id

		annotation SummarizationSetBy = Automatic

	/// Year key
	column year
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d89a991a-74bb-5e9c-a641-42e53b697343
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	/// Total population (SAMA)
	column population
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 0e41b8a6-3e4a-5144-8ca0-273f7b7936ab
		summarizeBy: none
		sourceColumn: population

		annotation SummarizationSetBy = Automatic

	/// Saudi population (GASTAT; 2010-2021 back-cast from the 2022 census)
	column saudi_population
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: fb12def9-75d4-5207-9880-cd02a188d2f8
		summarizeBy: none
		sourceColumn: saudi_population

		annotation SummarizationSetBy = Automatic

	partition fact_population = m
		mode: import
		source =
				let
				    // 1) read the clean CSV from 02_data; 2) if the folder is not reachable (project moved), use the embedded snapshot
				    Embedded = "",
				    FileBinary = try Binary.Buffer(File.Contents(DataFolder & "\fact_population.csv")) otherwise Binary.Decompress(Binary.FromText(Embedded, BinaryEncoding.Base64), Compression.Deflate),
				    Source = Csv.Document(FileBinary, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"region_id", Int64.Type}, {"year", Int64.Type}, {"population", Int64.Type}, {"saudi_population", Int64.Type}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

