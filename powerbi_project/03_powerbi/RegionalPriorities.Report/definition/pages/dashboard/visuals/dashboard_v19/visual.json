    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key insights",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#0B0B0B",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1  Najran is the clear first priority. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#EB6834",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Gap 1.94 vs 0.77 for #2; lowest Saudi median income (SAR 1,650/month), highest food share (43.5%), no foundations. #1 in all 6 sensitivity tests.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2  Jazan is second, also driven by fragility. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#EB6834",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "2nd-highest social security rate (9.84%), no foundations. Least stable priority: top 5 in 72.9% of 1,000 random weightings.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3  Madinah, Tabuk and Makkah: service gaps. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#2A78D6",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Fragility at or below average but among the lowest non-profit densities (8.56, 8.24, 5.54 per 100k). Makkah has the most beneficiaries of the five (245,796).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4  Non-profits are concentrated. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B0B0B",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Riyadh hosts 29% of all non-profits and 60% of foundations; Jazan, Hail, Al-Baha, Tabuk and Najran have none.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5  Al-Jouf is borderline. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B0B0B",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Top 5 in 2 of 6 tests and 27.5% of weightings: worth monitoring.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Recommendation",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#0B0B0B",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Donors targeting economic need: Najran, then Jazan (more beneficiaries reached). Donors targeting service gaps: Madinah, Tabuk, Makkah.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#0B0B0B",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The scenario slicer switches the gap definition (A-D). Click any bar or bubble to cross-filter; hover a region for its profile; right-click a region > Drill through > Region detail for every indicator and its organizations.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#6F6D66"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to read",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#0B0B0B",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gap = z(fragility) − z(non-profit density). Fragility = mean z-score of the social security rate, Saudi median income (reversed) and food share of spending. Density = non-profits per 100k residents. Ranking is relative across 13 regions, not an absolute measure of need. Indicators mix 2022 and 2023 (HIES) data; 2022 is a transition year for social security.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#6F6D66"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
