  },
  "pageBinding": {
    "name": "tooltip_region_binding",
    "type": "Tooltip",
    "parameters": [
      {
        "name": "tooltip_region_param",
        "boundFilter": "tooltip_region_filter",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_region"
              }
            },
            "Property": "region_en"
          }
